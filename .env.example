# Copying this file is optional; the recommended setup command writes .env securely:
# python3 scripts/configure_credentials.py

# Liblib: text-to-image fallback, Kling image-to-video and temporary keyframe upload
LIBLIB_ACCESS_KEY="replace_with_liblib_access_key"
LIBLIB_SECRET_KEY="replace_with_liblib_secret_key"

# Fish Audio: narration using s2.1-pro-free by default
FISH_API_KEY="replace_with_fish_audio_api_key"
